import java.util.*;

class Solution {
    public String reverseOnlyLetters(String s) {
        
        Stack<Character> st = new Stack<>();
        StringBuilder sb = new StringBuilder();

        for (int i = 0; i < s.length(); i++) {
            if (Character.isLetter(s.charAt(i))) {
                st.push(s.charAt(i));
            }
        }

        for (int i = 0; i < s.length(); i++) {
            if (Character.isLetter(s.charAt(i))) {
                sb.append(st.pop());
            } else {
                sb.append(s.charAt(i)); 
            }
        }

        return sb.toString();
    }
}
